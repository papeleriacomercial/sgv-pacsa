{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--browser=chromium",
        "--user-data-dir=.playwright-perfil",
        "--viewport-size=390,844"
      ]
    },

    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@0.9.0",
        "--read-only",
        "--project-ref=${SGV_SUPABASE_PROJECT_REF}",
        "--features=database,debugging,development,docs"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SGV_SUPABASE_ACCESS_TOKEN}"
      }
    },

    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    }
  }
}
